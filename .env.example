# =============================================================================
# TEMPLATE — ./customize.sh generates the real .env from these defaults.
# Do not edit and use this file directly: copy it to .env only if you want to
# configure everything by hand (start.sh still expects the keystores).
# =============================================================================
# Ocean Enterprise Stack — shared configuration (no SSI)
# Marketplace + OE Node (registry.agrospai.udl.cat, tag latest) + Elasticsearch 8.19.x
# Network: OP Sepolia (chainId 11155420) — main token: devEURAU
#
# Markers:
#   [CUSTOMIZE]       You MUST review/change this before a real deployment
#   [PLACEHOLDER]     Fabricated value — looks structured but is NOT valid
#                     for production. Replace with a real, generated secret.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC HOSTNAMES
# -----------------------------------------------------------------------------
# [CUSTOMIZE] Base URL of the OE Node AS SEEN FROM THE USER'S BROWSER.
# The marketplace front-end calls the node directly from the browser, so this
# must be reachable by your users. For a local single-machine trial,
# http://localhost:8000 works (the browser and the containers share the host).
# For any deployment accessed over the network, set the public hostname/IP
# (and put it behind a TLS-terminating reverse proxy — see docs post-install).
OE_NODE_URL=http://localhost:8000

# [CUSTOMIZE] Host ports the containers are published on
MARKET_HTTP_PORT=8080
NODE_HTTP_PORT=8000
ES_HTTP_PORT=9200

# -----------------------------------------------------------------------------
# BLOCKCHAIN — OP Sepolia (chainId 11155420)
# -----------------------------------------------------------------------------
# Free public RPC (verified working: https://sepolia.optimism.io).
# If you hit rate limits, switch to a keyed provider (Alchemy/Infura/
# Chainstack) and paste the provider URL here:  [CUSTOMIZE]
RPC_URL=https://sepolia.optimism.io

# Chain id and name used in the RPCS / node URI maps
CHAIN_ID=11155420
CHAIN_NAME=optimism_sepolia

# devEURAU (EURAU on OP Sepolia) — the main payment/fee token
DEVEURAU_ADDRESS=0xD35141583f374d401fee1BFdDc35910E1D33a588

# Indexer start block. ./start.sh asks which block to index from on a first
# launch (default = current head = no backfill) and rewrites this value.
# The number below is only a fallback for a hand-run `docker compose up`.
START_BLOCK=51415978

# -----------------------------------------------------------------------------
# IPFS — Pinata (free tier)
# -----------------------------------------------------------------------------
# Public gateway used by BOTH the node (to read DDOs) and the marketplace.
# Docs require a PUBLIC gateway so the node can fetch CIDs pinned by the
# marketplace at publish time.
IPFS_GATEWAY=https://gateway.pinata.cloud/
# Pinata upload/unpin endpoints (JSON pinning is what the market uses for DDOs)
IPFS_UPLOAD_URL=https://api.pinata.cloud/pinning/pinJSONToIPFS
IPFS_DELETE_URL=https://api.pinata.cloud/pinning/unpin

# [PLACEHOLDER] >>> YOU MUST REQUEST A TOKEN <<<
# Create a FREE account at https://app.pinata.cloud → API Keys → JWT.
# Publishing assets from the marketplace WILL FAIL until you replace this.
IPFS_JWT=REPLACE_ME_WITH_YOUR_PINATA_JWT_TOKEN

# -----------------------------------------------------------------------------
# ELASTICSEARCH (indexer DB for the OE Node)
# -----------------------------------------------------------------------------
# [PLACEHOLDER] Fabricated password following an obvious pattern —
# generate a real one: `openssl rand -base64 24`
ELASTIC_PASSWORD=OeDe...4567

# -----------------------------------------------------------------------------
# OE NODE
# -----------------------------------------------------------------------------
# [PLACEHOLDER] Fabricated private key: use ./customize.sh to generate the
# node keys in secrets/node.keystore.json and secrets/admin.keystore.json, then
# ./fund.sh if they need to be funded, finally ./start.sh injects PRIVATE_KEY.
NODE_PRIVATE_KEY=0x000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# [CUSTOMIZE] Node operator fee for serving downloads/C2D.
# amount is applied per purchase (per-unit is not implemented yet in OE Node).
NODE_FEE_AMOUNT={"amount":0,"unit":"MB"}

# [CUSTOMIZE] Web3 admin address(es) allowed to administer the node via API.
# Derived by customize.sh from secrets/admin.keystore.json (the admin wallet).
ALLOWED_ADMINS=["0x1111111111111111111111111111111111111111"]

# [CUSTOMIZE] Public info about the node owner shown in the marketplace.
NODE_OWNER_INFO={"imprint":{"legalName":"<company_name>","email":"<company_contact_email>","url":"<company_url>","address":"<company_address>"},"termsAndConditions":{"url":"<url_to_terms_and_conditions>"},"privacyPolicy":{"url":"<url_to_privacy_policy>"}}

# -----------------------------------------------------------------------------
# MARKETPLACE
# -----------------------------------------------------------------------------
# [CUSTOMIZE] Wallet address where marketplace fees are collected.
# Fabricated pattern below — replace with your marketplace fee wallet.
# Derived by customize.sh: the fee collector is the node wallet.
MARKET_FEE_ADDRESS=0x2222222222222222222222222222222222222222

# [CUSTOMIZE] Fixed market fee per purchase, in devEURAU smallest units
# (EURAU uses 18 decimals → "1000000000000000000" = 1 devEURAU).
MARKET_ORDER_FEE_MAP={"11155420":[{"token":"0xD35141583f374d401fee1BFdDc35910E1D33a588","amount":"0"}]}

# [CUSTOMIZE] Percentage market fee (0.1 = 10%). 0 = disabled.
MARKET_PERCENT_FEE=0

# [CUSTOMIZE] Dataspace id: assets published through this market get this tag
# and only assets with this tag are shown. Leave empty to disable filtering.
DATASPACE=

# AGROPORTAL - server-side key for ontology term suggestions in the publish/edit forms
# AGROPORTAL_API_KEY=<your-agroportal-api-key>
