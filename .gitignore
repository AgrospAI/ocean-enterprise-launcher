# Runtime data created by the stack
oe-node-logs/
oe-node-databases/
oe-node-c2d-storage/

# Local configuration and secrets — generated by ./customize.sh, never commit
.env
.env.bak.*
secrets/

# Keystore tooling installed on first run (ethers)
.tools/

# Local overrides (copy .env and keep secrets out of git)
.env.local
